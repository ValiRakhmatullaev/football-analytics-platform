FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps: ffmpeg for clip generation, build tools for some wheels
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU-only PyTorch first (skip huge CUDA downloads)
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install Python deps (backend + video_analytics)
COPY backend/requirements.txt /app/backend/requirements.txt
COPY video_analytics/requirements.txt /app/video_analytics/requirements.txt
RUN pip install --no-cache-dir \
    -r /app/backend/requirements.txt \
    -r /app/video_analytics/requirements.txt

# Copy project
COPY . /app

EXPOSE 8000

ENV DJANGO_SETTINGS_MODULE=config.settings.dev

CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8000"]
